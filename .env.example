# Production (Railway). `shopify app dev` sets the Shopify values automatically in development.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.up.railway.app
SCOPES=read_products,read_themes
# A postgres:// URL switches Prisma to prisma/postgres/schema.prisma. Leave unset locally (SQLite).
DATABASE_URL=
NODE_ENV=production

# Billing: test charges are used automatically outside production. Set to true to force
# test charges in production (e.g. for App Store review on a development store).
BILLING_TEST=false

# Owner panel at <app-url>/owner. Disabled (404) unless both are set.
OWNER_PASSWORD=
# Long random string, e.g. `openssl rand -hex 32`.
OWNER_SESSION_SECRET=
