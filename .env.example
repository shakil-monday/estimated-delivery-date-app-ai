# Production (Railway). `shopify app dev` sets the Shopify values automatically in development.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.up.railway.app
SCOPES=read_products,read_themes
# A postgres:// URL switches Prisma to prisma/postgres/schema.prisma. Leave unset locally (SQLite).
DATABASE_URL=
NODE_ENV=production
